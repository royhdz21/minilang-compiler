int x, y, z;
x = 1; y = 2;
if (x < y) { z = 1; } else { z = 0; }
print(z);                                 // 1
x = 5;
if (x < y) { z = 1; } else { z = 0; }
print(z);                                 // 0
if (x == 5) print(55);                    // 55
if (x != 5) print(66); else print(77);    // 77
